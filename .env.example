# 环境变量示例文件 —— 复制为 .env 并填入你自己的密钥
# cp .env.example .env
# ---------------------------------------------------
# 后端（server/）从此文件读取密钥，浏览器不会接触到密钥。

# ---- 后端服务 ----
SERVER_PORT=3100

# ---- 账号体系（登录/注册 + 分析记录持久化）----
# JWT 签名密钥：生产环境务必改成随机长字符串（如 openssl rand -hex 32 生成）
JWT_SECRET=change-me-to-a-random-secret
# SQLite 数据库位置（可选，缺省 server/data/agentmind.db）
# AGENTMIND_DB_PATH=D:/data/agentmind.db

# ---- 大模型 API（OpenAI Chat Completions 兼容，支持多模型）----
# 模型 1（必填，作为默认模型）
# OpenAI    : https://api.openai.com/v1/chat/completions
# DeepSeek  : https://api.deepseek.com/v1/chat/completions
# 智谱 GLM  : https://open.bigmodel.cn/api/paas/v4/chat/completions
# 通义千问   : https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
LLM_BASE_URL=https://api.deepseek.com/v1/chat/completions
LLM_API_KEY=your_llm_api_key
LLM_MODEL=deepseek-chat
LLM_LABEL=DeepSeek
# LLM 单次调用超时（毫秒）。数据量大/模型较慢时可上调，清洗已做分批优化，一般 150000 足够。
LLM_TIMEOUT=150000
# 同时打向上游的 LLM 请求数。多数账号组织并发上限为 1，超限会 HTTP 429。
LLM_CONCURRENCY=1
# 遇到 429 / 并发上限时的最大重试次数（每次按 Retry-After 或指数退避等待）。
LLM_MAX_RETRIES=5

# 主模型（可选，填模型 id：default/llm2/llm3/...）。
# 主模型排到列表首位，负责清洗·洞察·报告；缺省时以模型 1（default）为主。
LLM_PRIMARY=llm4

# 模型 2（可选，多模型协作。留空则只有模型 1 单独工作）
# 还可继续加 LLM3_*、LLM4_* … 最多 LLM12_*，规则相同。
# 配置 2 个以上模型时：分析阶段各模型独立分析后集成、验证阶段跨模型交叉复核。
# 上游请求默认串行（LLM_CONCURRENCY=1），避免组织并发上限触发 HTTP 429。
# LLM2_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
# LLM2_API_KEY=your_glm_api_key
# LLM2_MODEL=glm-4.7
# LLM2_LABEL=智谱 GLM-4.7
LLM2_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
LLM2_API_KEY=your_dashscope_api_key
LLM2_MODEL=glm-5
LLM2_LABEL=智谱 GLM-5

# 模型 3：阿里通义千问（阿里百炼 DashScope）
LLM3_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
LLM3_API_KEY=your_dashscope_api_key
LLM3_MODEL=qwen-math-turbo
LLM3_LABEL=通义千问 Qwen-Math

# 模型 4：Kimi（月之暗面 Moonshot）
# 模型名以账号 /v1/models 实际返回为准（如 kimi-k2.6）。
LLM4_BASE_URL=https://api.moonshot.cn/v1/chat/completions
LLM4_API_KEY=your_moonshot_api_key
LLM4_MODEL=kimi-k2.6
LLM4_LABEL=Kimi K2.6
# 固定温度（可选）：某些模型只接受特定温度（如 kimi 系列只允许 1）。
LLM4_TEMPERATURE=1

# 模型 5：硅基流动 SiliconFlow（MiniMax 等，模型名需带厂商前缀）
LLM5_BASE_URL=https://api.siliconflow.cn/v1/chat/completions
LLM5_API_KEY=your_siliconflow_api_key
LLM5_MODEL=MiniMaxAI/MiniMax-M2.5
LLM5_LABEL=MiniMax M2.5

# ---- Bocha 博查搜索（真实舆情采集，申请：https://open.bochaai.com/）----
BOCHA_API_KEY=your_bocha_api_key
# 接口类型：web（Web Search，便宜、够用，默认）| ai（AI Search，带总结，较贵）
BOCHA_MODE=web
BOCHA_BASE_URL=https://api.bochaai.com/v1/web-search

# ---- Anspire 安思派 AI 搜索（第二数据源，与 Bocha 聚合去重，缓解单一搜索源）----
# 申请后填入密钥。与 Bocha 至少配置一个即可采集；两者都配置时结果合并去重。
ANSPIRE_API_KEY=your_anspire_api_key
ANSPIRE_BASE_URL=https://plugin.anspire.cn/api/ntsearch/search
# 检索区域：0 国内 / 1 海外 / 2 国内海外混合（默认 0）
ANSPIRE_REGION_MODE=0

# ---- 天行数据 全网热搜榜（首页热搜渲染，申请：https://www.tianapi.com/）----
TIANAPI_KEY=your_tianapi_key
TIANAPI_HOTLIST_URL=https://apis.tianapi.com/networkhot/index

# ---- MindSpider 真实爬虫（AgentMind 自带组件，可选启用）----
# 前置条件（详见 README「MindSpider 爬虫接入」）：
#   1. 初始化 MediaCrawler 爬虫子模块（AgentMind 根目录执行）：
#      git submodule update --init --recursive
#   2. 安装 Python 依赖（桥接最小集，含 cp313 wheel，无需编译器）：
#      pip install -r mindspider/requirements-bridge.txt
#   3. playwright install chromium
#   4. 首次使用各平台需扫码登录（有界面的环境运行）
# ---- 爬虫 ----
MINDSPIDER_ENABLED=true
MINDSPIDER_PLATFORM=weibo
MINDSPIDER_PYTHON=C:\Users\TRS\AppData\Local\Programs\Python\Python313\python.exe
# 第一次扫码用 false；扫成功后改 true 再重启
MINDSPIDER_HEADLESS=false
