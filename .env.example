# 环境变量示例文件 —— 复制为 .env 并填入你自己的密钥
# cp .env.example .env
# ---------------------------------------------------
# 后端（server/）从此文件读取密钥，浏览器不会接触到密钥。

# ---- 后端服务 ----
SERVER_PORT=3100

# ---- 大模型 API（OpenAI Chat Completions 兼容，支持多模型）----
# 模型 1（必填，作为默认模型）
# OpenAI    : https://api.openai.com/v1/chat/completions
# DeepSeek  : https://api.deepseek.com/v1/chat/completions
# 智谱 GLM  : https://open.bigmodel.cn/api/paas/v4/chat/completions
# 通义千问   : https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
LLM_BASE_URL=https://api.deepseek.com/v1/chat/completions
LLM_API_KEY=your_llm_api_key
LLM_MODEL=deepseek-chat
LLM_LABEL=DeepSeek
LLM_TIMEOUT=100000

# 模型 2（可选，多模型协作。留空则只有模型 1 单独工作）
# 还可继续加 LLM3_*、LLM4_* … 最多 LLM12_*，规则相同。
# 配置 2 个以上模型时：分析阶段各模型并行集成、验证阶段跨模型交叉复核。
LLM2_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
LLM2_API_KEY=your_glm_api_key
LLM2_MODEL=glm-4.7
LLM2_LABEL=智谱 GLM-4.7

# 模型 3：阿里通义千问（阿里百炼 DashScope）
LLM3_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
LLM3_API_KEY=your_dashscope_api_key
LLM3_MODEL=qwen-math-turbo
LLM3_LABEL=通义千问 Qwen-Math

# 模型 4：Kimi（月之暗面 Moonshot）
LLM4_BASE_URL=https://api.moonshot.cn/v1/chat/completions
LLM4_API_KEY=your_moonshot_api_key
LLM4_MODEL=kimi-k3
LLM4_LABEL=Kimi K3

# 模型 5：硅基流动 SiliconFlow（MiniMax 等）
LLM5_BASE_URL=https://api.siliconflow.cn/v1/chat/completions
LLM5_API_KEY=your_siliconflow_api_key
LLM5_MODEL=MiniMax-M2.5
LLM5_LABEL=MiniMax M2.5

# ---- Bocha 博查搜索（真实舆情采集，申请：https://open.bochaai.com/）----
BOCHA_API_KEY=your_bocha_api_key
# 接口类型：web（Web Search，便宜、够用，默认）| ai（AI Search，带总结，较贵）
BOCHA_MODE=web
BOCHA_BASE_URL=https://api.bochaai.com/v1/web-search
